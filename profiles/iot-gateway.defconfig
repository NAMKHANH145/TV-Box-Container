# Buildroot defconfig — iot-gateway profile
# Mosquitto broker + clients, OpenSSL, SQLite, cURL. Dynamic musl (~8MB).
# NOTE: mosquitto requires !BR2_STATIC_LIBS, so this profile is dynamic.
# Build: ./profiles/build.sh iot-gateway

BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_PACKAGE_BUSYBOX=y

# IoT packages
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_BROKER=y
BR2_PACKAGE_MOSQUITTO_CLIENTS=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_CURL=y

BR2_TARGET_GENERIC_HOSTNAME="iot-gateway"
BR2_TARGET_GENERIC_ISSUE="minicontainer iot-gateway (buildroot)"
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y
BR2_CCACHE=y
