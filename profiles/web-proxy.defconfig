# Buildroot defconfig — web-proxy profile
# lighttpd + BusyBox, dynamic musl (~4MB). Local admin UI / static proxy.
# NOTE: lighttpd requires !BR2_STATIC_LIBS.
# Build: ./profiles/build.sh web-proxy

BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_PACKAGE_BUSYBOX=y

BR2_PACKAGE_LIGHTTPD=y

BR2_TARGET_GENERIC_HOSTNAME="web-proxy"
BR2_TARGET_GENERIC_ISSUE="minicontainer web-proxy (buildroot)"
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y
BR2_CCACHE=y
